<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The attempt to stop Sony's input service. ⚠️ A *normal* permission, but no guarantee:
         `killBackgroundProcesses` reaches background processes only, and a bound service often
         is not one. From Android 14 a third-party app may use it on its own processes only
         (ActivityManager.java:5329-5331) — the Bravia is Android 12, where that restriction does
         not yet apply. The app says so honestly when it was not enough. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- ⚠️ On a television only LEANBACK_LAUNCHER counts; with LAUNCHER alone the app
                     never appears on the Google TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
